# =============================================================================
# Copy this file to .env and fill in YOUR OWN values:   cp .env.example .env
# .env is private (git-ignored). Never share it, never push it to GitHub, and
# never paste its values into a chat. Lines starting with # are only notes.
# =============================================================================

# -----------------------------------------------------------------------------
# Telegram: the chat app the bot lives in (both values are required)
# -----------------------------------------------------------------------------
# The bot's token. Create a bot with @BotFather in Telegram and copy the token.
BOT_TOKEN=
# Your own numeric Telegram ID (ask the @userinfobot bot). Only this user can use
# the bot; messages from anyone else are ignored.
TELEGRAM_USER_ID=

# -----------------------------------------------------------------------------
# Notion: where your novels are stored
# -----------------------------------------------------------------------------
# The token of your Notion integration (notion.so/profile/integrations).
# Required. Share EVERY novel table with this integration (the "..." menu of the
# table -> Connections), and turn on its "Insert content" and "Update content"
# capabilities if you want /add and /edit to work.
NOTION_TOKEN=
# Required. The data source IDs of ALL your novel lists, separated by commas with no
# spaces, for example:  id_of_list1,id_of_list2,id_of_list3
# The ORDER matters: the first is "List 1", the next "List 2", and so on.
# The search, the /add duplicate warning and /edit all work in every one of these lists.
# Find an ID in Notion: "..." on the table -> Manage data sources -> Copy data source ID.
# Note: this is NOT the ID in the page URL (that one is the database ID).
NOTION_DATA_SOURCE_ID=
# Optional. The ONE list where /add puts NEW stories (for example the ID of list 3).
# It is searched even if it is missing from the first line. Leave empty to add to List 1.
NOTION_ADD_DATA_SOURCE_ID=

# -----------------------------------------------------------------------------
# Gemini: the AI that understands your questions
# -----------------------------------------------------------------------------
# Required. The API key from Google AI Studio (aistudio.google.com).
# Tip: set a spending limit there so a mistake can never cost much.
GEMINI_API_KEY=
# Optional. The Gemini model name. Leave empty to use the default (gemini-3.6-flash).
GEMINI_MODEL=

# -----------------------------------------------------------------------------
# Logging: the bot writes logs/bot.log (errors) and logs/writes.log (every Notion write)
# -----------------------------------------------------------------------------
# Optional. How detailed the log is: DEBUG, INFO, WARNING or ERROR.
# Leave empty to use INFO.
LOG_LEVEL=
